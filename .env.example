# ============================================================
# zkpool-mesh — environment template
# Copy to .env and fill in real values.
# ============================================================

# --- Backend -------------------------------------------------
DATABASE_URL=postgres://zkpool:zkpool_dev_password@postgres:5432/zkpool
REDIS_URL=redis://redis:6379
PORT=4001
SOLANA_RPC_URL=https://api.devnet.solana.com
MERKLE_URL=http://localhost:4003
PROVER_URL=http://localhost:4002
INDEXER_POLL_INTERVAL_SECS=5
INDEXER_PAGE_SIZE=100
INDEXER_MAX_PAGES=10
RATE_LIMIT_WITHDRAW_PER_MIN=5
RATE_LIMIT_READ_PER_MIN=60
MERKLE_TREE_DEPTH=20
LOG_FORMAT=pretty
RUST_LOG=info

# --- Prover --------------------------------------------------
CIRCUIT_DIR=/home/ubuntu/circuits/withdrawal
NARGO_BIN=nargo
SUNSPOT_BIN=sunspot
NARGO_TIMEOUT_SECS=30
SUNSPOT_TIMEOUT_SECS=30

# --- Postgres (docker-compose) -------------------------------
POSTGRES_USER=zkpool
POSTGRES_PASSWORD=zkpool_dev_password
POSTGRES_DB=zkpool

# --- Grafana -------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Verifier ------------------------------------------------
# Must match onchain/programs/zk_pool/src/constants.rs (VERIFIER_PROGRAM_ID).
# Update manually after every verifier redeploy.
VERIFIER_PROGRAM_ID=

# --- Solana (CLI / wallet path) ------------------------------
# Keypair lives at solana/id.json, mounted at ~/.config/solana
SOLANA_NETWORK=devnet
PROGRAM_ID=
POOL_ADDRESS=
PROVER_PORT=4002
DEFAULT_RPC=https://api.devnet.solana.com
POOL_SEED=pool3
VAULT_SEED=vault3
NULLIFIER_RECORD_SEED=nullifier_record
POOL_DISCRIMINATOR=134,215,119,168,28,199,193,127
DEPOSIT_DISCRIMINATOR=242,35,198,137,82,225,242,182
DEPOSIT_SPLIT_DISCRIMINATOR=50,17,130,17,119,220,174,118
WITHDRAW_DISCRIMINATOR=183,18,70,156,148,109,161,34
SYSTEM_PROGRAM_ID=11111111111111111111111111111111
COMPUTE_BUDGET_PROGRAM_ID=ComputeBudget111111111111111111111111111111
BACKEND_URL=http://127.0.0.1:4001
RPC_URL=https://api.devnet.solana.com
SPLIT_AMOUNTS=500000000,300000000,200000000
