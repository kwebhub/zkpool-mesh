# ============================================================
# zkpool-mesh — environment template
# Copy to .env and fill in real values.
# ============================================================

# --- Backend -------------------------------------------------
DATABASE_URL=postgres://zkpool:zkpool_dev_password@postgres:5432/zkpool
REDIS_URL=redis://redis:6379
PORT=4001
SOLANA_RPC_URL=https://api.devnet.solana.com
POOL_ADDRESS=
MERKLE_URL=http://localhost:4003
PROVER_URL=http://localhost:4002
INDEXER_POLL_INTERVAL_SECS=5
INDEXER_PAGE_SIZE=100
INDEXER_MAX_PAGES=10
RATE_LIMIT_WITHDRAW_PER_MIN=5
RATE_LIMIT_READ_PER_MIN=60
MERKLE_TREE_DEPTH=20
LOG_FORMAT=pretty
RUST_LOG=info

# --- Prover --------------------------------------------------
CIRCUIT_DIR=/home/ubuntu/circuits/withdrawal
NARGO_BIN=nargo
SUNSPOT_BIN=sunspot
NARGO_TIMEOUT_SECS=30
SUNSPOT_TIMEOUT_SECS=30

# --- Postgres (docker-compose) -------------------------------
POSTGRES_USER=zkpool
POSTGRES_PASSWORD=zkpool_dev_password
POSTGRES_DB=zkpool

# --- Grafana -------------------------------------------------
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# --- Solana (CLI / wallet path) ------------------------------
# Keypair lives at solana/id.json, mounted at ~/.config/solana
SOLANA_NETWORK=devnet
