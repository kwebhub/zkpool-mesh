FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
  LANG=C.UTF-8 \
  TZ=UTC

USER root

RUN apt-get update && \
  apt-get install -y curl git build-essential pkg-config libssl-dev \
  ca-certificates --no-install-recommends && \
  apt-get clean && rm -rf /var/lib/apt/lists/*

USER ubuntu
SHELL ["/bin/bash", "-c"]
WORKDIR /home/ubuntu

ENV PATH="/home/ubuntu/.local/share/solana/install/active_release/bin:/home/ubuntu/.cargo/bin:/home/ubuntu/.avm/bin:/home/ubuntu/.noirup/bin:/home/ubuntu/.nargo/bin:/home/ubuntu/.local/share/pnpm:${PATH}"
ENV NVM_DIR="/home/ubuntu/.nvm"

# Artifacts pre-fetched by `make bootstrap`.
COPY --chown=ubuntu:ubuntu cache/sunspot                   /home/ubuntu/sunspot
COPY --chown=ubuntu:ubuntu cache/solana-install/install.sh /tmp/install-solana.sh
COPY --chown=ubuntu:ubuntu cache/nargo/install.sh          /tmp/install-noirup.sh
COPY --chown=ubuntu:ubuntu cache/nvm/install.sh            /tmp/install-nvm.sh
COPY --chown=ubuntu:ubuntu cache/pnpm/install.sh           /tmp/install-pnpm.sh

RUN echo 'export GNARK_VERIFIER_BIN="$HOME/sunspot/gnark-solana/crates/verifier-bin"' >> /home/ubuntu/.bashrc && \
  bash /tmp/install-solana.sh && \
  bash /tmp/install-noirup.sh && \
  mkdir -p "$NVM_DIR" && \
  bash /tmp/install-nvm.sh && \
  bash -c "source $NVM_DIR/nvm.sh && nvm install 24 && nvm alias default 24" && \
  env PNPM_VERSION=12.5.1 ENV="$HOME/.bashrc" SHELL="$(which bash)" bash /tmp/install-pnpm.sh && \
  cargo install cargo-deny --locked --version 0.20.2 && \
  cargo install cargo-audit --locked && \
  echo 'export NVM_DIR="$HOME/.nvm"' >> $HOME/.bashrc && \
  echo '[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"' >> $HOME/.bashrc && \
  echo '[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"' >> $HOME/.bashrc

CMD ["/bin/bash"]
