FROM debian:13

ENV DEBIAN_FRONTEND=noninteractive \
  LANG=C.UTF-8 \
  TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  libssl3 \
  libssl-dev \
  libudev1 \
  libclang-dev \
  protobuf-compiler \
  curl \
  git \
  build-essential \
  pkg-config \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash i

USER i
SHELL ["/bin/bash", "-c"]
WORKDIR /home/i

ENV HOME=/home/i \
  CARGO_HOME=/home/i/.cargo \
  RUSTUP_HOME=/home/i/.rustup \
  PATH=/home/i/.cargo/bin:/home/i/.local/share/solana/install/active_release/bin:/home/i/.local/bin:/opt/go/bin:${PATH}

COPY --chown=i:i cache/solana-dev/solana-install/ /home/i/.local/share/solana/install/
COPY --chown=i:i cache/solana-dev/solana-config-install/ /home/i/.config/solana/install/
COPY --chown=i:i cache/solana-dev/bin/ /home/i/.local/bin/
COPY --chown=i:i cache/solana-dev/rustup/ /home/i/.rustup/
COPY --chown=i:i cache/cargo-bin/ /home/i/.cargo/bin/
COPY --chown=i:i cache/cargo-registry/ /home/i/.cargo/registry/
COPY --chown=i:i cache/cargo-git/ /home/i/.cargo/git/
COPY --chown=i:i cache/go/ /opt/go/
COPY --chown=i:i cache/sunspot/ /home/i/sunspot/
COPY --chown=i:i cache/nargo/nargo /home/i/.local/bin/nargo
COPY --chown=i:i cache/solana-dev/platform-tools/ /home/i/.cache/solana/

RUN rm -f /home/i/.local/bin/cargo-build-sbf \
  /home/i/.local/share/solana/install/active_release/bin/cargo-build-sbf

ENV SOLANA_DISABLE_UPDATE=1 \
  AGAVE_DISABLE_UPDATE=1 \
  SOLANA_INSTALL_NO_UPDATE=1

RUN bash -c 'set -e; \
  solana --version; \
  anchor --version; \
  rustc --version; \
  cargo-deny --version; \
  cargo-audit --version; \
  cargo-build-sbf --version; \
  /opt/go/bin/go version; \
  /home/i/.local/bin/nargo --version'

ENV GNARK_VERIFIER_BIN=/home/i/sunspot/gnark-solana/crates/verifier-bin

CMD ["/bin/bash"]
