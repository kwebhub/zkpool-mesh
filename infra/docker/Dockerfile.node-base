FROM debian:13

ENV DEBIAN_FRONTEND=noninteractive \
  LANG=C.UTF-8 \
  TZ=UTC

RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  libatomic1 \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /bin/bash i

USER i
SHELL ["/bin/bash", "-c"]
WORKDIR /home/i

ENV HOME=/home/i \
  PNPM_HOME=/home/i/.local/share/pnpm \
  PATH=/home/i/.local/share/pnpm/bin:/home/i/.local/node/bin:${PATH}

COPY --chown=i:i cache/solana-dev/node/ /home/i/.local/node/
COPY --chown=i:i cache/pnpm/ /home/i/.local/share/pnpm/

RUN node --version && npm --version && pnpm --version

CMD ["/bin/bash"]
